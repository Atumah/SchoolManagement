# Apache HTTP Server Configuration
# Copy relevant sections to C:\Apache24\conf\httpd.conf

# Server root (change this line)
Define SRVROOT "C:/Apache24"

# Enable these modules (uncomment by removing #)
LoadModule rewrite_module modules/mod_rewrite.so
LoadModule headers_module modules/mod_headers.so

# Document root (change this line)
DocumentRoot "C:/inetpub/wwwroot/schoolmanagement/public"

# Directory configuration (change this line)
<Directory "C:/inetpub/wwwroot/schoolmanagement/public">
    Options Indexes FollowSymLinks
    AllowOverride All
    Require all granted
</Directory>

# Directory index (change this line)
DirectoryIndex index.php index.html

# PHP Configuration (add at the end of file)
LoadModule php_module "C:/PHP/php8apache2_4.dll"
PHPIniDir "C:/PHP"
AddType application/x-httpd-php .php


