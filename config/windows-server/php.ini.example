# PHP Configuration
# Copy to C:\PHP\php.ini
# Uncomment (remove semicolon) from these lines:

; Extension directory
extension_dir = "C:/PHP/ext"

; Enable these extensions
extension=mysqli
extension=pdo_mysql
extension=intl
extension=zip

; Session configuration
session.save_path = "C:/Windows/Temp"

; File uploads
upload_max_filesize = 10M
post_max_size = 10M

; Error reporting (for production, set to Off)
display_errors = Off
error_reporting = E_ALL & ~E_DEPRECATED & ~E_STRICT

